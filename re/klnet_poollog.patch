+/* [Net] PoolLog=1: where the slot pool lives and how big it is, said whenever it or the scene changes (re\private_match.md,
+   "pool lifetime"). Chain: M = [0xe0ff90] (the slot manager), P = [M+0xc] (the pool), P+4 = slot size, P+8 = cap in slots,
+   P+0xc = memory block, P+0x10 = table of cap signed 16-bit tags (negative = free). Reads only, every one through klh_rd.
+   Polled (not hooked): a change shorter than the 100 ms poll can be missed, a scene name that changes before the pool does
+   gives two lines - read them as a pair. */
+static int klnet_poollog;
+static void klnet_pool_tick(void)
+{
+    static DWORD last, sig0, seen; static WORD tags[0x20000];
+    DWORD now = GetTickCount(), mgr, pool, sz = 0, cap = 0, blk = 0, tab = 0, sig, k; char scene[160]; int i, live = 0, maxtag = -1, tags_ok = 0;
+    if (now - last < 100) return;
+    last = now;
+    mgr = klh_rd32((DWORD_PTR)KLH_VA(0x00e0ff90));
+    pool = mgr ? klh_rd32(mgr + 0xc) : 0;
+    if (!pool || !klh_rd(pool + 4, &sz, 4) || !klh_rd(pool + 8, &cap, 4) || !klh_rd(pool + 0xc, &blk, 4) || !klh_rd(pool + 0x10, &tab, 4)) sz = cap = blk = tab = 0;
+    if (!klh_scene(scene, sizeof scene)) scene[0] = 0;
+    sig = mgr; sig = sig * 31 + pool; sig = sig * 31 + cap; sig = sig * 31 + sz; sig = sig * 31 + blk;
+    for (i = 0; scene[i]; i++) sig = sig * 31 + (BYTE)scene[i];
+    if (seen && sig == sig0) return;
+    sig0 = sig; k = ++seen;
+    if (cap && cap <= 0x20000 && tab && klh_rd(tab, tags, cap * 2)) {      /* a tag >= 0 is a slot in use, < 0 is free: -1 = never used, -t-2 = freed (0x8861a0) */
+        tags_ok = 1;
+        for (i = 0; i < (int)cap; i++) if ((short)tags[i] >= 0) { live++; if ((short)tags[i] > maxtag) maxtag = (short)tags[i]; }
+    }
+    klog("net: pool #%lu: scene '%s'; manager [0xe0ff90]=%08lx, pool [mgr+0xc]=%08lx, slot size %lu, cap %lu, block %08lx, tags %08lx%s; %s",
+         k, scene, mgr, pool, sz, cap, blk, tab, !mgr ? " (NO MANAGER: the pool is gone, or not built yet)" : !pool ? " (manager without a readable pool)" : "",
+         tags_ok ? "slots with tag >= 0:" : "tags not read");
+    if (tags_ok) klog("net: pool #%lu: %d slot(s) with tag >= 0 (in use; a freed slot is negative), highest tag %d (0 = every slot was handed out once at most); cap*%lu = %lu bytes", k, live, maxtag, sz, cap * sz);
+}
 static struct { int have; struct klnet_num stock[KLNET_NDS], ours[KLNET_NDS]; int wrote[KLNET_NDS]; } klnet_t;
 
