 Model::~Model() {
   for (auto& [name, buffer] : matrices_) context_.destroyBuffer(buffer);
-  for (auto& [name, tensor] : tensors_) context_.destroyBuffer(tensor.raw);
+  if (synthetic_) context_.destroyBuffer(zeroRaw_);   // klnr patch: one shared raw buffer
+  else
+    for (auto& [name, tensor] : tensors_) context_.destroyBuffer(tensor.raw);
 }
 
 const Tensor& Model::tensor(int block, int layer, const std::string& parameter) const {
   std::string name = "block" + std::to_string(block) + ".layer" + std::to_string(layer) + "." + parameter;
   auto it = tensors_.find(name);
+  if (it == tensors_.end() && synthetic_) {   // klnr patch: every tensor of the synthetic model is zero
+    Tensor tensor;
+    tensor.name = name; tensor.block = block; tensor.layer = layer; tensor.parameter = parameter; tensor.stage = "zero";
+    tensor.byteLength = (uint32_t)zeroBytes_.size();
+    tensor.bytes = zeroBytes_.data();
+    tensor.raw = zeroRaw_;
+    it = tensors_.emplace(name, tensor).first;
+  }
   if (it == tensors_.end()) throw std::runtime_error("missing tensor " + name);
   return it->second;
 }
